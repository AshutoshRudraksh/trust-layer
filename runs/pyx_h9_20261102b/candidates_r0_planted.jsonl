{"lesson":{"created_from_trace_id":"db479be87bb13f9abab8262cbf42d67adc7bcf23cfc442c3a33858fdf656a64d","fixes_criterion_id":"T1.C1","lesson_id":"L_T1.C1_9dd514bb","scope":"paper_anatomy","status":"candidate","text":"When transcribing a results table, reproduce every column header verbatim and copy each cell exactly as printed, preserving units, scaling, and missing-value markers rather than normalizing, renaming, or inferring values from surrounding text.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T1.C1_9dd514bb","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2303.11366v4","source_trace_id":"db479be87bb13f9abab8262cbf42d67adc7bcf23cfc442c3a33858fdf656a64d","text_sha256":"9dd514bbeb880a3931ee8c9a83a11023408950b287b8fda76ca2ddf7c497093c"}}
