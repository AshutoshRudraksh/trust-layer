{"lesson":{"created_from_trace_id":"e9c73eff83f6b1512cb99cc6629c72b80f2e6cda015da2916d34c62d8453fe92","fixes_criterion_id":"T1.C1","lesson_id":"L_T1.C1_78cb44e5","scope":"paper_anatomy","status":"candidate","text":"When reporting a results table, transcribe headers and every cell verbatim with original units and missing-value marks, keep columns strictly aligned to their headers, and never borrow, convert, round, or reformat values from text or other tables.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T1.C1_78cb44e5","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2303.11366v4","source_trace_id":"e9c73eff83f6b1512cb99cc6629c72b80f2e6cda015da2916d34c62d8453fe92","text_sha256":"78cb44e5e1ea90f97c86e11f11a7f2793861c0a4fdb0446f87d91309474cc027"}}
{"lesson":{"created_from_trace_id":"e9c73eff83f6b1512cb99cc6629c72b80f2e6cda015da2916d34c62d8453fe92","fixes_criterion_id":"T1.C4","lesson_id":"L_T1.C4_a4e3bfcf","scope":"paper_anatomy","status":"candidate","text":"When transcribing a results table, copy every row label and column header verbatim including parenthetical qualifiers, preserve all method-model combinations as separate rows without merging or renaming, and keep the original metric scale and formatting without conversion.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T1.C4_a4e3bfcf","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2303.11366v4","source_trace_id":"e9c73eff83f6b1512cb99cc6629c72b80f2e6cda015da2916d34c62d8453fe92","text_sha256":"a4e3bfcfa1ce99fe91bbc17b5568baa9b6c044ef83ccc2460edb3405e68b98b9"}}
{"lesson":{"created_from_trace_id":"e9c73eff83f6b1512cb99cc6629c72b80f2e6cda015da2916d34c62d8453fe92","fixes_criterion_id":"T1.C8","lesson_id":"L_T1.C8_79e93c16","scope":"paper_anatomy","status":"candidate","text":"For any results table paired with an analysis section, do not only transcribe cell values; define what auxiliary diagnostic columns measure and summarize the authors' textual explanation of causes, trends, and implications.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T1.C8_79e93c16","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2303.11366v4","source_trace_id":"e9c73eff83f6b1512cb99cc6629c72b80f2e6cda015da2916d34c62d8453fe92","text_sha256":"79e93c169ff6d8ae142cab2a2f4c2c229e118714e07e9aefce182a415e5a928d"}}
{"lesson":{"created_from_trace_id":"e2f0ef9dc374fda6effbb3735eded3fabc5de57d33e2a3f63223a3112df2c4ef","fixes_criterion_id":"T2.C1","lesson_id":"L_T2.C1_677695aa","scope":"paper_anatomy","status":"candidate","text":"When transcribing a large comparison table, reproduce every row and every metric column exactly as printed, keep each model variant as a separate row, and leave cells blank where the paper leaves them blank instead of inferring or merging values.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T2.C1_677695aa","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2407.01489v2","source_trace_id":"e2f0ef9dc374fda6effbb3735eded3fabc5de57d33e2a3f63223a3112df2c4ef","text_sha256":"677695aab658e7c70e1c3b83ba9944c7d8c07f41056e271ab5bd69eb431f9f61"}}
