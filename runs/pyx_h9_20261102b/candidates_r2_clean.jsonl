{"lesson":{"created_from_trace_id":"7e86f1323a7cd51fd451a695fad51a64f971f6faac2a8ea0727a6ee304cd4282","fixes_criterion_id":"T1.C1","lesson_id":"L_T1.C1_5e334926","scope":"paper_anatomy","status":"candidate","text":"When transcribing comparison tables, reproduce every cell exactly as printed with its original scale and units, keep similarly named baseline columns strictly separate, and preserve missing-value symbols and any parenthetical attribution text instead of normalizing or omitting them.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T1.C1_5e334926","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2303.11366v4","source_trace_id":"7e86f1323a7cd51fd451a695fad51a64f971f6faac2a8ea0727a6ee304cd4282","text_sha256":"5e334926269fbff3b7ab9c07e37d390375c1dfbf1b7539449d12add911b4a9e6"}}
{"lesson":{"created_from_trace_id":"7e86f1323a7cd51fd451a695fad51a64f971f6faac2a8ea0727a6ee304cd4282","fixes_criterion_id":"T1.C4","lesson_id":"L_T1.C4_0c13f2b4","scope":"paper_anatomy","status":"candidate","text":"Always reproduce every table row with its complete method identifier verbatim including all qualifiers and keep all metric columns in the exact scale and units printed, checking each cell against the source without normalizing labels or converting formats.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T1.C4_0c13f2b4","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2303.11366v4","source_trace_id":"7e86f1323a7cd51fd451a695fad51a64f971f6faac2a8ea0727a6ee304cd4282","text_sha256":"0c13f2b48b1109769a3aac74645b03cd2ab6e74176c8bc735e9e4419fd7d83c3"}}
{"lesson":{"created_from_trace_id":"7e86f1323a7cd51fd451a695fad51a64f971f6faac2a8ea0727a6ee304cd4282","fixes_criterion_id":"T1.C8","lesson_id":"L_T1.C8_a5ca069b","scope":"paper_anatomy","status":"candidate","text":"When a results table includes diagnostic metrics alongside main scores, define each diagnostic in words and summarize the authors' own textual explanation of trends and failure modes instead of transcribing cell values alone.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T1.C8_a5ca069b","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2303.11366v4","source_trace_id":"7e86f1323a7cd51fd451a695fad51a64f971f6faac2a8ea0727a6ee304cd4282","text_sha256":"a5ca069b58533043fce165076df165196946439ccf12ad02a81068dcf2683b19"}}
{"lesson":{"created_from_trace_id":"6d0f03bc12578c4bc5303f2e09b5fab822ddf0954f44637b75226537e35a901c","fixes_criterion_id":"T2.C1","lesson_id":"L_T2.C1_538d756b","scope":"paper_anatomy","status":"candidate","text":"When reporting a main results table, transcribe every row and column exactly as printed, keeping each method variant on its own separate row, preserving missing-value markers and units verbatim, and verify total row count and column alignment against the source before finishing.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T2.C1_538d756b","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2407.01489v2","source_trace_id":"6d0f03bc12578c4bc5303f2e09b5fab822ddf0954f44637b75226537e35a901c","text_sha256":"538d756b517db97eea7f81a878bce1d5b11f288f4370e963c80ac583ccc3a77d"}}
{"lesson":{"created_from_trace_id":"6d0f03bc12578c4bc5303f2e09b5fab822ddf0954f44637b75226537e35a901c","fixes_criterion_id":"T2.C3","lesson_id":"L_T2.C3_068d3aad","scope":"paper_anatomy","status":"candidate","text":"Always verify you have located and fully transcribed every numbered results table in the paper, continuing past the first tables and never stopping early or truncating, and confirm completeness before submitting.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T2.C3_068d3aad","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2407.01489v2","source_trace_id":"6d0f03bc12578c4bc5303f2e09b5fab822ddf0954f44637b75226537e35a901c","text_sha256":"068d3aad850d4bc47a595e45662f86e3dafcb82bc2097f7e6ec4eeb8bf802a88"}}
{"lesson":{"created_from_trace_id":"6d0f03bc12578c4bc5303f2e09b5fab822ddf0954f44637b75226537e35a901c","fixes_criterion_id":"T2.C4","lesson_id":"L_T2.C4_f3a2f005","scope":"paper_anatomy","status":"candidate","text":"Always verify the paper's full list of result tables and transcribe each one completely with all rows and columns, checking for pagination or continuation to avoid truncating or omitting later tables.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T2.C4_f3a2f005","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2407.01489v2","source_trace_id":"6d0f03bc12578c4bc5303f2e09b5fab822ddf0954f44637b75226537e35a901c","text_sha256":"f3a2f005d0b9e62ff71a26ab62d508599d8d9c5b89f6ef4b8c7eb913eaef825d"}}
{"lesson":{"created_from_trace_id":"6d0f03bc12578c4bc5303f2e09b5fab822ddf0954f44637b75226537e35a901c","fixes_criterion_id":"T2.C5","lesson_id":"L_T2.C5_3e056d1c","scope":"paper_anatomy","status":"candidate","text":"When reporting any results table, transcribe every row and every metric column in full and verify completeness against the source; never truncate the table or leave a final aggregate row partially filled, always count rows to confirm nothing is missing.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T2.C5_3e056d1c","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2407.01489v2","source_trace_id":"6d0f03bc12578c4bc5303f2e09b5fab822ddf0954f44637b75226537e35a901c","text_sha256":"3e056d1c244e1d1e7bbd9500e035432a2ce5d62ea3dadb025bad2b099f9ae9f0"}}
