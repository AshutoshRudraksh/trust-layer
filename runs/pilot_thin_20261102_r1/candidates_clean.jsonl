{"lesson":{"created_from_trace_id":"0fd0cedbbbd93173514fa8e03145d6779621d772aaa0a10af519a0e584ea030b","fixes_criterion_id":"T1.C1","lesson_id":"L_T1.C1_dfa7b126","scope":"paper_anatomy","status":"candidate","text":"When reporting a comparison table, reproduce all rows and column headers exactly as labeled, keep similar baseline columns separate, preserve dash or empty markers for missing entries, and retain any qualifier text attached to a score rather than merging or dropping columns.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T1.C1_dfa7b126","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2303.11366v4","source_trace_id":"0fd0cedbbbd93173514fa8e03145d6779621d772aaa0a10af519a0e584ea030b","text_sha256":"dfa7b126835e2156123a685a41a7aa9e2763588ada50708a8f919bab09426e55"}}
