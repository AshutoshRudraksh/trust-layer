{"lesson":{"created_from_trace_id":"e8215c384b6a3f8e06a6d09ba37da1b9f6dc098c9d1bd5de56f74a89359e2243","fixes_criterion_id":"T2.C8","lesson_id":"L_T2.C8_f718bced","scope":"paper_anatomy","status":"candidate","text":"When a results table breaks performance down by multiple granularity levels and method variants, report every level-variant combination using exact table labels rather than summarizing only one comparison.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T2.C8_f718bced","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2407.01489v2","source_trace_id":"e8215c384b6a3f8e06a6d09ba37da1b9f6dc098c9d1bd5de56f74a89359e2243","text_sha256":"f718bced8b6415ec140a37cf9b5878f474054b77ce5691b3703047a5eec57ee2"}}
