{"lesson":{"created_from_trace_id":"3acc2a1f5ded0d8c52856b48ec46c5f48f165456697d660be8f5adaaa83ec116","fixes_criterion_id":"T1.C1","lesson_id":"L_T1.C1_59c8ef44","scope":"paper_anatomy","status":"candidate","text":"Always transcribe each metric exactly as printed in the cited table after confirming row, column, variant and metric definition, and never infer, round, combine, or compute derived differences from memory.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T1.C1_59c8ef44","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2303.11366v4","source_trace_id":"3acc2a1f5ded0d8c52856b48ec46c5f48f165456697d660be8f5adaaa83ec116","text_sha256":"59c8ef44b713e5579cc62f97e9473c86cdb5440e17f2e334b820307c821e568a"}}
{"lesson":{"created_from_trace_id":"3acc2a1f5ded0d8c52856b48ec46c5f48f165456697d660be8f5adaaa83ec116","fixes_criterion_id":"T1.C3","lesson_id":"L_T1.C3_db4737fc","scope":"paper_anatomy","status":"candidate","text":"When summarizing an ablation table, list each condition separately and copy each metric exactly from its intersecting row and column, never inferring or combining values across rows.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T1.C3_db4737fc","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2303.11366v4","source_trace_id":"3acc2a1f5ded0d8c52856b48ec46c5f48f165456697d660be8f5adaaa83ec116","text_sha256":"db4737fce07b0b5869bd89eee48b77b8bcf908cc758c976f55324f246923b95f"}}
{"lesson":{"created_from_trace_id":"3acc2a1f5ded0d8c52856b48ec46c5f48f165456697d660be8f5adaaa83ec116","fixes_criterion_id":"T1.C6","lesson_id":"L_T1.C6_a622758d","scope":"paper_anatomy","status":"candidate","text":"When describing architecture, enumerate every model, module, and memory store exactly as labeled in the figure and methods section and verify each role, rather than simplifying or omitting supporting components.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T1.C6_a622758d","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2303.11366v4","source_trace_id":"3acc2a1f5ded0d8c52856b48ec46c5f48f165456697d660be8f5adaaa83ec116","text_sha256":"a622758dd5bbc3d056b9b0e5a5050497dafda0537d7594f50977db0380524f06"}}
{"lesson":{"created_from_trace_id":"3acc2a1f5ded0d8c52856b48ec46c5f48f165456697d660be8f5adaaa83ec116","fixes_criterion_id":"T1.C8","lesson_id":"L_T1.C8_db44700b","scope":"paper_anatomy","status":"candidate","text":"Never invent causal explanations for observed gains or regressions; report only the results shown and include an interpretation only when the authors explicitly state it in the cited text.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T1.C8_db44700b","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2303.11366v4","source_trace_id":"3acc2a1f5ded0d8c52856b48ec46c5f48f165456697d660be8f5adaaa83ec116","text_sha256":"db44700b03af451847f12d0613a032109f4b6aa2ac7e85aa7c03c250189a6b22"}}
{"lesson":{"created_from_trace_id":"e8215c384b6a3f8e06a6d09ba37da1b9f6dc098c9d1bd5de56f74a89359e2243","fixes_criterion_id":"T2.C2","lesson_id":"L_T2.C2_1fb082d4","scope":"paper_anatomy","status":"candidate","text":"When reporting the main results table, transcribe each configuration's solved count, percentage, cost, and token use exactly as labeled in its own row, preserving units and per-issue scope without rounding, converting, or mixing rows.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T2.C2_1fb082d4","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2407.01489v2","source_trace_id":"e8215c384b6a3f8e06a6d09ba37da1b9f6dc098c9d1bd5de56f74a89359e2243","text_sha256":"1fb082d447fd9245993c9963e3d2a7b7a485ad840e9340264ee51a8d64c25128"}}
{"lesson":{"created_from_trace_id":"e8215c384b6a3f8e06a6d09ba37da1b9f6dc098c9d1bd5de56f74a89359e2243","fixes_criterion_id":"T2.C3","lesson_id":"L_T2.C3_33cfe628","scope":"paper_anatomy","status":"candidate","text":"When summarizing ablation or incremental-variant tables, quote each condition from its exact row and recompute any claimed gain by subtracting the two relevant rows rather than copying narrative summaries.","version":1},"provenance":{"approved_at":"","approver":"","distiller_model":"muse-spark-1.3-contributor","lesson_id":"L_T2.C3_33cfe628","replay_run_ids":[],"source_kind":"graded_failure","source_paper_id":"2407.01489v2","source_trace_id":"e8215c384b6a3f8e06a6d09ba37da1b9f6dc098c9d1bd5de56f74a89359e2243","text_sha256":"33cfe628f3b005f717179165f875b4523e2288a9ce88bc5e4b03ddd213ef24c9"}}
